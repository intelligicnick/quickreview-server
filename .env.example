NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
# Hostinger: mysql://USER:PASSWORD@localhost:3306/DATABASE (URL-encode special chars in password)
DATABASE_URL=mysql://quickreview:quickreview@localhost:3306/quickreview
DATABASE_SYNC=true
# Production: DATABASE_SYNC=false, DATABASE_MIGRATIONS_RUN=true
# DATABASE_MIGRATIONS_RUN=true
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# log | brevo
EMAIL_MODE=log
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_FROM_NAME=QuickReview
# BREVO_API_KEY=

# Razorpay (optional — UPI/cash + admin mark-paid still work without it)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Google Business Profile + Places (Phase 2)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/google/oauth/callback
# Places Text Search (public listings — separate from OAuth client secret)
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY=mock for local/tests without billing
# GOOGLE_PLACES_REGION=IN
# GOOGLE_TOKEN_ENCRYPTION_KEY=optional-separate-secret-for-stored-refresh-tokens
# SUPER_ADMIN_EMAIL=you@example.com
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=Super Admin
# GEMINI_API_KEY=mock for template drafts in tests; set a real key for AI suggestions and QuickScan
# GEMINI_MODEL=gemini-2.0-flash
# QuickDesign images via Perchance (https://perchance.org/ai-text-to-image-generator)
# Optional: paste userKey from one generate request (Network tab). If unset, API tries auto session fetch.
# PERCHANCE_USER_KEY=
# PERCHANCE_AUTO_SESSION=true
# QUICKDESIGN_IMAGE_PROVIDER=perchance
